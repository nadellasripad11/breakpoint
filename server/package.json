{
  "name": "breakpoint-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Breakpoint backend: deterministic scheduling engine + REST API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "check": "tsc --noEmit && node --test \"test/**/*.test.ts\"",
    "sim": "node scripts/sim.ts",
    "test:d1": "node scripts/test-d1.mjs",
    "cf:deploy": "npx --yes wrangler@4.50.0 deploy",
    "cf:migrate": "npx --yes wrangler@4.50.0 d1 migrations apply breakpoint-db --remote"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
