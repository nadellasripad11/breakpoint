# Copy to .env and edit. Node reads real environment variables; load this file with:
#   node --env-file=.env src/index.ts          (or: npm start -- with the vars exported in your shell)

NODE_ENV=development
PORT=8787
HOST=127.0.0.1

# SQLite database file (created automatically; the folder is created for you)
DATABASE_PATH=./data/breakpoint.db

# Browser origins allowed to call the API (CORS + post-login redirects). Comma separated. https only in production.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of THIS API (used to build the Google OAuth redirect URIs)
API_URL=http://localhost:8787

# 32 random bytes, base64. REQUIRED in production. Encrypts stored OAuth tokens (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Cookies. In production COOKIE_SECURE must be true. Use SameSite=Lax when the API is on the same site as the app
# (e.g. app.example.com + api.example.com). For a different site use Bearer-token mode instead (see docs/FRONTEND.md).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=.example.com

# Only when running behind a reverse proxy you control (affects rate-limit client IPs)
# TRUST_PROXY=true

# Google OAuth (optional: guest demo and .ics import work without it)
# Console: https://console.cloud.google.com/apis/credentials  (type: Web application)
# Authorized redirect URIs:
#   {API_URL}/api/auth/google/callback          (sign-in)
#   {API_URL}/api/connections/google/callback   (calendar connection, read-only)
# Enable the "Google Calendar API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_TTL_DAYS=30
GUEST_TTL_HOURS=24
